# Single-user web access gate. Generate both secrets with: openssl rand -hex 32
M1CRO_WEB_PASSWORD=
M1CRO_WEB_SESSION_SECRET=

# Server-to-server runtime connection. Never expose these with NEXT_PUBLIC_.
M1CRO_RUNTIME_URL=http://127.0.0.1:8787
M1CRO_RUNTIME_TOKEN=

# Runtime project workspaces (defaults to M1CRO_DATA_DIR/projects)
M1CRO_PROJECTS_DIR=

# Vercel Sandbox runtime manager (server-side only)
M1CRO_RUNTIME_SANDBOX_NAME=m1cro-runtime
M1CRO_RUNTIME_PORT=4310
M1CRO_RUNTIME_CWD=/vercel/m1cro.ai
M1CRO_VERCEL_PROJECT_ID=prj_EvPmkvb8nzGr7emYcmahghUY1QWB
M1CRO_VERCEL_TEAM_ID=team_ZQIfBVBy7MVnJBHBqvea6X1D

# 32-byte hex key used by the runtime to encrypt provider API keys at rest.
# Store as a Vercel Sensitive environment variable; never use NEXT_PUBLIC_.
M1CRO_PROVIDER_CONFIG_KEY=
